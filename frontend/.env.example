# Browser-facing API base (used by client components and the admin panel)
NEXT_PUBLIC_API_URL=http://localhost:4000/api
# Optional server-side override (e.g. an internal Docker hostname). Falls back to NEXT_PUBLIC_API_URL.
API_URL=http://localhost:4000/api
# Public site address, used for canonical URLs, Open Graph, sitemap.xml and structured data. Set to the live domain before launch.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
